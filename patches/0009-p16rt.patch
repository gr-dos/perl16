+/* perl16: <stdarg.h> */
+int
+deb(void *pat, ...)
 {
     va_list args;
-    char *pat;
     register int i;
 
-    va_start(args);
+    va_start(args, pat);
     fprintf(stderr,"%-4ld",(long)curcmd->c_line);
     for (i=0; i<dlevel; i++)
 	fprintf(stderr,"%c%c ",debname[i],debdelim[i]);
 
-    pat = va_arg(args, char *);
-    (void) vfprintf(stderr,pat,args);
+    (void) vfprintf(stderr,(char *)pat,args);
     va_end( args );
 }
 #  endif
