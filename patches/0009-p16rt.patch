diff --git a/perly.c b/perly.c
--- a/perly.c
+++ b/perly.c
@@ -89,11 +89,25 @@
 static bool minus_c;
 static char patchlevel[6];
 
+#ifdef P16_RT
+/*
+ * perl16: libc16's startup calls main(argc, argv) with SP at the top of
+ * the stack, which is the end of the program's memory block, so a third
+ * parameter would be the DOS memory control block that follows it, and
+ * assigning env would overwrite it. env is a local here.
+ */
+main(argc,argv)
+register int argc;
+register char **argv;
+{
+    register char **env;
+#else
 main(argc,argv,env)
 register int argc;
 register char **argv;
 register char **env;
 {
+#endif
     register STR *str;
     register char *s;
     char *index(), *strcpy(), *getenv();
@@ -127,9 +141,11 @@
      * space.  The other alternative would be to provide STDAUX and STDPRN
      * filehandles.
      */
+#ifndef P16_RT		/* perl16: libc16 has no stdaux or stdprn stream */
     (void)fclose(stdaux);
     (void)fclose(stdprn);
 #endif
+#endif
     if (do_undump) {
 	origfilename = savestr(argv[0]);
 	do_undump = 0;
