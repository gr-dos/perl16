     }
     return status;
 }
 
+#ifdef P16_RT
+/*
+ * perl16: split s into a, in place, as libc16's startup splits a
+ * command tail (its docs/spec/startup.md): runs of spaces and tabs
+ * separate arguments; a double quote toggles quoting and is removed;
+ * 2n backslashes and a quote give n backslashes and toggle quoting,
+ * 2n + 1 give n and a literal quote; other backslashes are literal.
+ * libc16's spawn functions quote each argument so that this gives it
+ * back, so a program run directly sees the arguments it would see if
+ * the command reached it as written, quotes and all. An argument is
+ * never longer than its text, so the copy can't overtake the reading.
+ */
+static void
+p16_split(s, a)
+register char *s;
+register char **a;
+{
+    register char *d = s;
+    int quoted, n;
+
+    for (;;) {
+	while (*s == ' ' || *s == '\t')
+	    s++;
+	if (!*s)
+	    break;
+	*a++ = d;
+	quoted = 0;
+	while (*s && (quoted || (*s != ' ' && *s != '\t'))) {
+	    if (*s == '\\') {
+		for (n = 0; *s == '\\'; n++)
+		    s++;
+		if (*s == '"') {
+		    for (; n >= 2; n -= 2)
+			*d++ = '\\';
+		    if (n) {		/* an escaped, literal quote */
+			*d++ = '"';
+			s++;
+		    }
+		}
+		else
+		    while (n-- > 0)
+			*d++ = '\\';
+	    }
+	    else if (*s == '"') {
+		quoted = !quoted;
+		s++;
+	    }
+	    else
+		*d++ = *s++;
+	}
+	if (*s)
+	    s++;
+	*d++ = '\0';
+    }
+    *a = Nullch;
+}
+#endif
+
 int
 do_spawn(cmd)
 char *cmd;
@@ -220,21 +298,38 @@
     char **argv;
     char flags[10];
     int status;
-    char *shell, *cmd2;
+    char *cmd2;
+#ifndef P16_RT
+    char *shell;
 
     /* save an extra exec if possible */
     if ((shell = getenv("COMSPEC")) == 0)
 	shell = "\\command.com";
+#endif
 
     /* see if there are shell metacharacters in it */
     if (strchr(cmd, '>') || strchr(cmd, '<') || strchr(cmd, '|'))
 	  doshell:
+#ifdef P16_RT
+	    /*
+	     * perl16: COMSPEC /C followed by the command exactly as it
+	     * is, with environ, so the shell and what it runs see %ENV
+	     * (libc16_systeme, libc16 0.15). The shell is the one COMSPEC
+	     * names in the environment DOS gave Perl; a COMSPEC set in
+	     * %ENV is passed on but doesn't choose it.
+	     */
+	    return libc16_systeme(cmd, environ);
+#else
 	    return spawnl(P_WAIT,shell,shell,"/c",cmd,(char*)0);
+#endif
 
     New(1102,argv, strlen(cmd) / 2 + 2, char*);
 
     New(1103,cmd2, strlen(cmd) + 1, char);
     strcpy(cmd2, cmd);
+#ifdef P16_RT
+    p16_split(cmd2, argv);
+#else
     a = argv;
     for (s = cmd2; *s;) {
 	while (*s && isspace(*s)) s++;
@@ -245,8 +340,13 @@
 	    *s++ = '\0';
     }
     *a = Nullch;
+#endif
     if (argv[0])
+#ifdef P16_RT
+	if ((status = spawnvpe(P_WAIT,argv[0],argv,environ)) == -1) {
+#else
 	if ((status = spawnvp(P_WAIT,argv[0],argv)) == -1) {
+#endif
 	    Safefree(argv);
 	    Safefree(cmd2);
 	    goto doshell;
