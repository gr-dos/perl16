From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Graham Ollis <plicease@cpan.org>
Date: Mon, 16 Nov 2026 10:00:00 -0700
Subject: [PATCH] MS-DOS: glob without a helper program

On MS-DOS, <*.c> reads the output of "perlglob *.c" through mypopen()
(evalargs.xc), but the historical port built its helper as glob.exe, so
globbing never worked as shipped; and a helper costs a child process,
COMMAND.COM and the memory for both (docs/M0-AUDIT.md, section 4).

mypopen() now recognises "perlglob PATTERNS" and writes the expansion
itself, with perl16's msdos/dosglob.c, to the temporary file it would
have run the command into, in the NUL-separated form glob.exe printed.
Nothing else about piped opens changes. docs/M2-REPORT.md, section 7,
has the matching rules.
---
 msdos/popen.c | 16 ++++++++++++++++
 1 file changed, 16 insertions(+)

diff --git a/msdos/popen.c b/msdos/popen.c
index 1834e85..82541e9 100644
--- a/msdos/popen.c
+++ b/msdos/popen.c
@@ -24,6 +24,8 @@
 #include <stdlib.h>
 #include <stdio.h>
 #include <process.h>
+#include <string.h>
+#include "dosglob.h"
 
 /*
  * Possible actions on an popened file
@@ -88,11 +90,25 @@ mypopen(const char *command, const char *t)
 
 	switch (*t) {
 	case 'r':
+		/* perl16: <*.c> globs without a helper (msdos/dosglob.c) */
+		if (strncmp(command, "perlglob ", 9) == 0) {
+			if ((f = fopen(name, "w")) == NULL) {
+				free(name);
+				return NULL;
+			}
+			if ((perl16_glob(command + 9, f) != 0) | (fclose(f) == EOF)
+			    || (f = fopen(name, "r")) == NULL) {
+				(void)unlink(name);
+				free(name);
+				return NULL;
+			}
+		} else {
 		sprintf(buff, "%s>%s", command, name);
 		if (system(buff) || (f = fopen(name, "r")) == NULL) {
 			free(name);
 			return NULL;
 		}
+		}
 		if (add(f, command, name, delete)) {
 			(void)fclose(f);
 			(void)unlink(name);
