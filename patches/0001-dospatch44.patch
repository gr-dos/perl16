From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Graham Ollis <plicease@cpan.org>
Date: Sun, 15 Nov 2026 17:45:09 -0700
Subject: [PATCH 1/3] dospatch44: the MS-DOS maintenance patch, less its
 Makefile hunk

Diomidis Spinellis's maintenance patch for the MS-DOS port of perl 3.0
patch level 44 (dospatch44, 1999-01-10), as published at
https://www2.dmst.aueb.gr/dds/sw/ports/dosperl/dospatch44 (sha256
8083cee5ce1b8867fd1a6c1ab8154f2433c13e4dcdf51080abe57f85ab0eb843;
scripts/fetch-reference). It was made against Spinellis's own
perl3.0-44.tar.gz, which differs from tag perl-3.044 only in file names
and whitespace (docs/M0-AUDIT.md, section 2), and applies to the tag
unchanged.

Every hunk is kept except the one for msdos/Makefile, which perl16 does
not use:

- eval.c: alarm() is a fatal error under MSDOS (the message is corrected
  in the next patch).
- msdos/config.h: SIG_NAME on one line (it was split mid-token, which no
  compiler accepts); S_ISBLK() and S_ISFIFO() are 0.
- msdos/msdos.c: setuid(), setgid() and userinit() stubs.
- perly.c: -v no longer prints the usage message after the version.
---
 eval.c         |  5 +++++
 msdos/config.h |  9 ++++-----
 msdos/msdos.c  | 14 ++++++++++++++
 perly.c        |  3 ---
 4 files changed, 23 insertions(+), 8 deletions(-)

diff --git a/eval.c b/eval.c
index ae0edbf..11b5ec5 100644
--- a/eval.c
+++ b/eval.c
@@ -1366,6 +1366,7 @@ register int sp;
 #endif
 	goto donumset;
     case O_ALARM:
+#ifndef MSDOS
 	if (maxarg < 1)
 	    tmps = str_get(stab_val(defstab));
 	else
@@ -1377,6 +1378,10 @@ register int sp;
 	    goto say_undef;
 	value = (double)anum;
 	goto donumset;
+#else
+	fatal("Unsupported function fork");
+	break;
+#endif
     case O_SLEEP:
 	if (maxarg < 1)
 	    tmps = Nullch;
diff --git a/msdos/config.h b/msdos/config.h
index f664cda..61f6884 100644
--- a/msdos/config.h
+++ b/msdos/config.h
@@ -470,11 +470,7 @@
 /* SIG_NAME:
  *	This symbol contains an list of signal names in order.
  */
-#define SIG_NAME
- "ZERO","HUP","INT","QUIT","ILL","TRAP","IOT","EMT","FPE","KILL","BUS","SEGV","S
-YS","PIPE","ALRM","TERM","URG","STOP","TSTP","CONT","CHLD","TTIN","TTOU","IO","X
-CPU","XFSZ","VTALRM","PROF","WINCH","USR1","USR2"		/**/
-
+#define SIG_NAME "ZERO","HUP","INT","QUIT","ILL","TRAP","IOT","EMT","FPE","KILL","BUS","SEGV","SYS","PIPE","ALRM","TERM","URG","STOP","TSTP","CONT","CHLD","TTIN","TTOU","IO","XCPU","XFSZ","VTALRM","PROF","WINCH","USR1","USR2"		/**/ 
 /* STDCHAR:
  *	This symbol is defined to be the type of char used in stdio.h.
  *	It has the values "unsigned char" or "char".
@@ -538,3 +534,6 @@ CPU","XFSZ","VTALRM","PROF","WINCH","USR1","USR2"		/**/
 #define S_ISUID 0
 #define S_ISGID 0
 #define CASTNEGFLOAT
+
+#define S_ISBLK(x) 0
+#define S_ISFIFO(x) 0
diff --git a/msdos/msdos.c b/msdos/msdos.c
index 7deb0aa..c2f3e5a 100644
--- a/msdos/msdos.c
+++ b/msdos/msdos.c
@@ -156,6 +156,18 @@ getgid(void)
 	return 0;
 }
 
+int
+setuid(int u)
+{
+	return 0;
+}
+
+int
+setgid(int u)
+{
+	return 0;
+}
+
 int
 getegid(void)
 {
@@ -244,3 +256,5 @@ char *cmd;
     Safefree(argv);
     return status;
 }
+
+void userinit() { }
diff --git a/perly.c b/perly.c
index 87acead..16ebe88 100644
--- a/perly.c
+++ b/perly.c
@@ -1115,9 +1115,6 @@ char *s;
 	fputs("\n\
 Perl may be copied only under the terms of the GNU General Public License,\n\
 a copy of which can be found with the Perl 3.0 distribution kit.\n",stdout);
-#ifdef MSDOS
-        usage(origargv[0]);
-#endif
 	exit(0);
     case 'w':
 	dowarn = TRUE;
