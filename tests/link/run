#!/bin/sh
# Self-test of scripts/check-link with fixture maps (*-map.txt; .map is
# ignored by git): a link from approved inputs passes, and each of a
# module and library from Open Watcom's runtime, an unlisted object, a
# missing library and an object with a default-library record (OMF
# comment class 9Fh) fails, with the message for that reason.
set -u
dir=$(dirname "$0")
tmp=${TMPDIR:-/tmp}/check-link.$$
mkdir -p "$tmp" && trap 'rm -rf "$tmp"' EXIT
check=$dir/../../scripts/check-link
fail=0
# t.obj: a THEADR record, and d.obj the same with a default-library comment.
printf '\200\003\000\001t\213' > "$tmp/t.obj"
cp "$tmp/t.obj" "$tmp/d.obj"
printf '\210\010\000\000\237clibl\000' >> "$tmp/d.obj"
sed "s|t.obj(|$tmp/t.obj(|" "$dir/good-map.txt" > "$tmp/good.map" || exit 1
sed "s|t.obj(|$tmp/t.obj(|" "$dir/bad-map.txt" > "$tmp/bad.map" || exit 1
sed "s|t.obj(|$tmp/d.obj(|" "$dir/good-map.txt" > "$tmp/dlib.map" || exit 1
# expect pass|"MESSAGE" ARGS...: MESSAGE must be in the output of a failure.
expect() {
    want=$1; shift
    if "$check" "$@" >"$tmp/out" 2>&1; then got=pass; else got=fail; fi
    what=$(echo "$*" | sed "s|$tmp/||g")
    if [ "$want" = pass ] && [ "$got" = pass ]; then
	echo "ok: pass: $what"
    elif [ "$want" != pass ] && [ "$got" = fail ] && grep -qF "$want" "$tmp/out"; then
	echo "ok: fail ($(echo "$want" | sed "s|$tmp/||g")): $what"
    else
	echo "NOT OK: wanted ${want}: $what"
	sed 's/^/  /' "$tmp/out"
	fail=1
    fi
}
expect pass "$tmp/good.map" "$tmp/t.obj" LIBC16L.LIB
expect "module memcpy.c from /watcom/lib286/dos/clibl.lib" \
    "$tmp/bad.map" "$tmp/t.obj" LIBC16L.LIB
expect "library /watcom/lib286/dos/clibl.lib" \
    "$tmp/bad.map" "$tmp/t.obj" LIBC16L.LIB
expect "module t.c from $tmp/t.obj" "$tmp/good.map" LIBC16L.LIB
expect "library LIBC16L.LIB" "$tmp/good.map" "$tmp/t.obj"
expect "d.obj: default library clibl" "$tmp/dlib.map" "$tmp/d.obj" LIBC16L.LIB
exit $fail
