#!/usr/bin/env perl

use 5.036;
use warnings;
use autodie qw(open close);
use File::Basename qw(basename);
use File::Copy qw(copy);
use File::Path qw(make_path remove_tree);
use File::Spec;
use FindBin;
use lib $FindBin::Bin;
use DosRun qw(write_config run_batch dos_files slurp);

=head1 NAME

run-dos - run Perl test scripts with a DOS PERL.EXE under DOSBox-X

=head1 SYNOPSIS

  tests/run-dos PERL.EXE DIR...

=head1 DESCRIPTION

Each F<NAME.pl> in each DIR is a case (NAME at most 8 characters). Its
expected standard output is F<NAME.out> next to it, compared after CRLF
is turned into LF. Comment lines at the top of the script can say:

  # status: N        the expected exit status (default 0)
  # command: ARGS    run PERL ARGS instead of PERL NAME.PL
  # setup: LINE      a batch line run before PERL (any number of them)
  # todo: REASON     a known failure: reported, but not counted as one
  # todo-BUILD: REASON
                     the same, only when BUILD (below) is BUILD, such
                     as todo-dev: a failure of one build that the
                     others must not have

Any other file in DIR is a fixture, copied into the work directory
under its name in upper case.

DOS cannot redirect standard error, so a script that needs its
diagnostics checked starts with C<open(STDERR, "E<gt>&STDOUT")>.

Each case runs in its own DOSBox-X session, on an emulated 8086 (core
normal, cputype 8086, CGA machine) with C: mounted on a work directory
(F<build/run-dos>) holding PERL.EXE and the cases, and is killed if it
takes longer than DOSBOX_TIMEOUT seconds. Its output and the result of
its exit-status check are collected afterwards. Exits 0 if every case
not marked todo passes.

A build can have slow cases of its own. SLOW names a file of them, one
per line as C<NAME REASON> (blank lines and C<#> comments ignored). A
listed case that times out is reported as slow and not counted as a
failure; one that fails in any other way (the wrong output or exit
status) is a failure as usual, and one that passes is reported, so the
entry can be removed. A name that isn't a case is an error.

Environment: DOSBOX (default dosbox-x), DOSBOX_TIMEOUT seconds per case
(default 60), WORK (default build/run-dos) the work directory, KEEP=1 to
keep it, BUILD the build being tested (for todo-BUILD; the Makefile
passes dev or rt), SLOW the file of slow cases, FILES more fixtures
(paths separated by spaces, such as built test tools), copied like the
others.

=cut

my ($exe, @dirs) = @ARGV;
die "usage: $0 PERL.EXE DIR...\n" unless @dirs;
die "$exe not found\n" unless -f $exe;
my $timeout = $ENV{DOSBOX_TIMEOUT} // 60;

my $work = File::Spec->rel2abs($ENV{WORK} // "build/run-dos");
remove_tree($work);
make_path($work);
copy($exe, "$work/PERL.EXE") or die "copy $exe: $!\n";

my (@cases, %seen);
for my $dir (@dirs) {
    for my $pl (sort glob "$dir/*.pl") {
        my $name = uc basename($pl, '.pl');
        die "$pl: name longer than 8 characters\n" if length $name > 8;
        die "$pl: $name is used twice\n" if $seen{$name}++;
        my %case = (name => $name, file => $pl, status => 0,
                    command => "PERL $name.PL", setup => []);
        for (split /\n/, slurp($pl)) {
            last unless /^#/;
            $case{status}  = $1 if /^#\s*status:\s*(\d+)/;
            $case{command} = "PERL $1" if /^#\s*command:\s*(.+?)\s*$/;
            $case{todo}    = $1 if /^#\s*todo:\s*(.+?)\s*$/;
            $case{todo}    = $2 if /^#\s*todo-(\w+):\s*(.+?)\s*$/
                && defined $ENV{BUILD} && $1 eq $ENV{BUILD};
            push @{ $case{setup} }, $1 if /^#\s*setup:\s*(.+?)\s*$/;
        }
        (my $exp = $pl) =~ s/\.pl$/.out/;
        die "$pl: no $exp\n" unless -f $exp;
        $case{expect} = slurp($exp);
        copy($pl, "$work/$name.PL") or die "copy $pl: $!\n";
        push @cases, \%case;
    }
}
die "no cases\n" unless @cases;

if (my $slow = $ENV{SLOW}) {
    my %case = map { $_->{name} => $_ } @cases;
    for (split /\n/, slurp($slow)) {
        next if /^\s*(#|$)/;
        my ($name, $why) = /^(\S+)\s+(.+?)\s*$/
            or die "$slow: not NAME REASON: $_\n";
        my $c = $case{uc $name} or die "$slow: $name is not a case\n";
        $c->{slow} = $why;
    }
}

# Any other file in a case directory is a fixture, copied as it is under
# its name in upper case.
for my $dir (@dirs) {
    for my $f (grep { -f && !/\.(pl|out)$/ } glob "$dir/*") {
        my $name = uc basename($f);
        die "$f: $name is used twice\n" if $seen{$name}++;
        copy($f, "$work/$name") or die "copy $f: $!\n";
    }
}

for my $f (split ' ', $ENV{FILES} // '') {
    my $name = uc basename($f);
    die "$f: $name is used twice\n" if $seen{$name}++;
    copy($f, "$work/$name") or die "copy $f: $!\n";
}

# Each case runs in its own DOSBox-X session, so one that hangs is
# killed after DOSBOX_TIMEOUT seconds without stopping the others. Its
# exit status N passes when errorlevel >= N and not >= N + 1.
write_config($work);

for my $c (@cases) {
    my ($n, $st) = @$c{qw(name status)};
    my @bat = ('@echo off', @{ $c->{setup} }, "$c->{command} >$n.OUT");
    push @bat, sprintf 'if errorlevel %d goto f', $st + 1 if $st < 255;
    push @bat, "if not errorlevel $st goto f";
    push @bat, "echo ok >$n.RC", 'goto d', ':f', "echo bad >$n.RC", ':d';
    $c->{timedout} = run_batch($work, \@bat, $timeout, "$work/$n.LOG");
}
my %dosfile = dos_files($work);

my ($pass, $fail, $todo, $slow) = (0, 0, 0, 0);
for my $c (@cases) {
    my $n = $c->{name};
    my @why;
    my $rc = $dosfile{"$n.RC"};
    my $out = $dosfile{"$n.OUT"};
    if (!defined $rc) {
        push @why, $c->{timedout} ? "timed out after ${timeout}s" : "did not finish";
    } else {
        push @why, "exit status is not $c->{status}"
            unless slurp($rc) =~ /^ok/;
        my $got = defined $out ? slurp($out) =~ s/\r\n/\n/gr : '';
        push @why, 'output differs' unless $got eq $c->{expect};
        if ($got ne $c->{expect}) {
            open my $g, '>:raw', "$work/$n.GOT";
            print $g $got;
            close $g;
        }
    }
    if (!@why) {
        if ($c->{todo}) {
            say "$n: passes, but is marked todo ($c->{todo})";
        }
        if ($c->{slow}) {
            say "$n: passes, but is listed as slow in $ENV{SLOW} ($c->{slow})";
        }
        $pass++;
    } elsif ($c->{slow} && !defined $rc && $c->{timedout}) {
        say "$n: slow: $c->{slow} (timed out after ${timeout}s)";
        $slow++;
    } elsif ($c->{todo}) {
        say "$n: todo: $c->{todo} (" . join('; ', @why) . ')';
        $todo++;
    } else {
        say "$n: FAIL: " . join('; ', @why) . " ($c->{file})";
        $fail++;
    }
}

say "run-dos: $pass passed, $fail failed, $todo todo",
    $slow ? ", $slow slow" : '';
say "run-dos: work directory $work (output of failures in NAME.GOT)"
    if $fail || $todo || $slow || $ENV{KEEP};
remove_tree($work) unless $fail || $todo || $slow || $ENV{KEEP};
exit($fail ? 1 : 0);
