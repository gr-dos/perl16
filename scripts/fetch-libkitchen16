#!/bin/sh
#
# Fetch the pinned libkitchen16 release (github.com/gr-dos/libkitchen16) into DIR:
# download libkitchen16-VERSION.zip, check its SHA-256 against the one below
# before unpacking it, and unpack its libkitchen16-VERSION/ directory as DIR.
# Reuses DIR if it already holds that archive.
#
# The canonical copy is consumers/fetch-libkitchen16 in libkitchen16. A
# program keeps a copy as scripts/fetch-libkitchen16 and changes version
# and sha256 together, deliberately, to the values of a published release
# (its .sha256 asset); see libkitchen16's docs/CONSUMERS.md, "Using
# libkitchen16".
#
# usage: scripts/fetch-libkitchen16 [DIR]     (default: build/libkitchen16)
#
# LIBKITCHEN16_URL, if set, is fetched instead of the release asset (a mirror,
# or a candidate archive being tested); it must have the same SHA-256.

set -eu

version=0.02
sha256=2ca356b7d2a23442b7851b10c09cfa577ee3888eaf5b4b899f10ee494162cb85

url=${LIBKITCHEN16_URL:-https://github.com/gr-dos/libkitchen16/releases/download/v$version/libkitchen16-$version.zip}
dir=${1:-build/libkitchen16}
stamp="$dir/.zip-sha256"

if [ "$(cat "$stamp" 2>/dev/null)" != "$sha256" ]; then
  mkdir -p "$(dirname "$dir")"
  zip="$dir.zip"
  if ! { [ -f "$zip" ] && echo "$sha256  $zip" | sha256sum -c --status; }; then
    rm -f "$zip"
    curl -fsSL -o "$zip.tmp" "$url"
    echo "$sha256  $zip.tmp" | sha256sum -c --quiet
    mv "$zip.tmp" "$zip"
  fi
  rm -rf "$dir" "$dir.tmp"
  mkdir -p "$dir.tmp"
  unzip -q -DD "$zip" -d "$dir.tmp"     # files get the current time
  [ "$(cat "$dir.tmp/libkitchen16-$version/VERSION")" = "$version" ]
  mv "$dir.tmp/libkitchen16-$version" "$dir"
  rmdir "$dir.tmp"
  echo "$sha256" > "$stamp"
fi
